<?php
/**
 * 【使い方】このファイルを同じフォルダに config.local.php という名前でコピーし、
 * 実際の値を記入してください。ここに書いた項目だけが config.php の既定値を
 * 上書きします（書かない項目は config.php の値のまま）。
 *
 * config.local.php は Git で追跡されず、education フォルダを上書き配置しても
 * 消えないので、接続情報が毎回リセットされるのを防げます。
 *
 * 管理者（承認者）のIDとパスワードは、ここではなく画面で設定します
 * （初回は管理画面に「初回設定」が表示されます）。
 */
if (!defined('EDU_APP')) { http_response_code(403); exit('Forbidden'); }

return [
    // ---- MySQL（保存先）----
    // レセプトアプリと同じ MySQL なら receipt/config/config.php と同じ値
    'mysql' => [
        'host'     => '127.0.0.1',
        'port'     => '3306',
        'database' => 'receipt_db',
        'user'     => 'receipt_user',
        'pass'     => 'ここにMySQLのパスワード',
    ],

    // ---- 選択肢の初期値を変える場合（丸ごと置き換え）----
