<?php
/**
 * 【使い方】このファイルを同じフォルダに config.local.php という名前でコピーし、
 * 実際の値を記入してください。ここに書いた項目だけが config.php の既定値を
 * 上書きします（書かない項目は config.php の値のまま）。
 *
 * config.local.php は Git で追跡されず、callback フォルダを上書き配置しても
 * 消えないので、接続情報が毎回リセットされるのを防げます。
 *
 * 管理者のIDとパスワードは、ここではなく画面で設定します
 * （初回は管理画面に「初回設定」が表示されます）。
 */
if (!defined('CB_APP')) { http_response_code(403); exit('Forbidden'); }

return [
    // ---- MySQL（保存先）----
    // レセプトアプリと同じ MySQL なら receipt/config/config.php と同じ値
    'mysql' => [
        'host'     => '127.0.0.1',
        'port'     => '3306',
        'database' => 'receipt_db',
        'user'     => 'receipt_user',
        'pass'     => 'ここにMySQLのパスワード',
    ],

    // ---- 相手先の区分を変える場合（丸ごと置き換え）----
    // 'party_types' => ['患者本人', '患者家族', '他の医療機関', '業者', 'その他'],

    // ---- 部署マスタの初期値を変える場合（丸ごと置き換え・コード => 名称）----
    // 最初にアプリを開いたときだけDBへ登録されます。以後は管理画面の「部署マスタ」で編集してください
    // 'departments' => ['0001' => '診療部', '0019' => '看護部', '0099' => 'その他'],

    // ---- 掲示期間の選択肢（時間）・既定値を変える場合 ----
